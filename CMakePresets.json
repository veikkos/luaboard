{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Simulator and tools (Ninja, Release)",
      "description": "macOS and Linux; on Windows from a Developer prompt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs",
      "displayName": "Simulator and tools (Visual Studio 2022)",
      "description": "Windows, from any shell",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "vs", "configurePreset": "vs", "configuration": "Release" }
  ]
}
