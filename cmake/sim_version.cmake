# The simulator build's version, as ESP-IDF puts it in a device image (git
# describe), for the image tag in platform/esp32-mock/src/mock_ota.c. Runs at
# every build; the header is rewritten only when the version changed, so a
# new commit (or a dirty tree) rebuilds that one file and nothing else.
#
#   cmake -DSRC=<repo> -DOUT=<header> -P sim_version.cmake
execute_process(
    COMMAND git describe --tags --always --dirty
    WORKING_DIRECTORY "${SRC}"
    OUTPUT_VARIABLE ver
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR ver STREQUAL "")
    set(ver "unknown")
endif()
set(text "/* Generated by cmake/sim_version.cmake: do not edit. */\n#define SIM_PROJECT_VER \"${ver}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
