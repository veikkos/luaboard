# Turns text files into a C header of byte arrays, so the firmware can carry
# its built-in Lua libraries (app/lua/*.lua) on every compiler (C23 #embed is
# not everywhere yet). Run as a script:
#
#   cmake -DOUT=builtin_lua_data.h -DFILES="a.lua;b.lua" -P embed_files.cmake
#
# Each file becomes `static const char embed_<name>[]` (its bytes and a 0, so
# sizeof - 1 is the length), <name> being the file name with every character
# that isn't a letter or digit made `_`: prelude.lua -> embed_prelude_lua.
# The header is only rewritten when it would change, so nothing rebuilds
# needlessly.
if(NOT OUT OR NOT FILES)
    message(FATAL_ERROR "usage: cmake -DOUT=<header> -DFILES=<file;...> -P embed_files.cmake")
endif()

set(text "/* Generated by cmake/embed_files.cmake: do not edit. */\n#pragma once\n")
foreach(f IN LISTS FILES)
    get_filename_component(name "${f}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" id)
    file(READ "${f}" hex HEX)
    # Every byte as 0xNN, 16 to a line.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
    string(APPEND text "\n/* ${name} */\nstatic const char embed_${id}[] = {\n    ${bytes}0\n};\n")
endforeach()

set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
